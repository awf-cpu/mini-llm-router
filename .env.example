# The router defaults to the offline "mock" provider, so it runs and tests pass
# with NO keys set. Set these only to enable real providers in your config.

# Required only when a route uses the "openai" provider.
OPENAI_API_KEY=

# Optional: override the local Ollama host (default http://127.0.0.1:11434).
OLLAMA_HOST=http://127.0.0.1:11434
